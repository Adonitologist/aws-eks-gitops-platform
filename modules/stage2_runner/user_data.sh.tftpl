#!/bin/bash
# First-boot bootstrap of the stage 2 runner (AL2023). Runs once, as root.
# Downloads use HTTPS only because the private subnet NACLs allow TCP 443 egress only.
set -euo pipefail
exec > >(tee -a /var/log/stage2-runner-bootstrap.log) 2>&1

die() { echo "ERROR: $*" >&2; exit 1; }

dnf install -y git tmux unzip
# The AL2023 standard AMI ships the AWS CLI v2; install it only when it is missing
command -v aws > /dev/null || dnf install -y awscli-2

# Swap file: the aws and helm providers can exceed the instance RAM
if ! swapon --show=NAME --noheadings | grep -q '^/swapfile$'; then
  fallocate -l ${swap_size_gb}G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

workdir="$(mktemp -d)"
cd "$workdir"

# Pinned Terraform: SHA256SUMS must carry a valid HashiCorp signature (key pinned by fingerprint,
# embedded here, never fetched from the artifact host) and the zip must match it before install
fpr=C874011F0AB405110D02105534365D9472D7468F
cat > hashicorp-pgp-key.asc <<'KEY_EOF'
${hashicorp_pgp_key}
KEY_EOF
export GNUPGHOME="$workdir/gnupg"
install -d -m 0700 "$GNUPGHOME"
gpg --batch --quiet --import hashicorp-pgp-key.asc
[ "$(gpg --batch --with-colons --fingerprint | awk -F: '/^fpr:/{print $10; exit}')" = "$fpr" ]   || die "embedded HashiCorp key does not match the pinned fingerprint $fpr"
tf_base="https://releases.hashicorp.com/terraform/${terraform_version}"
tf_zip="terraform_${terraform_version}_linux_amd64.zip"
tf_sums="terraform_${terraform_version}_SHA256SUMS"
curl -fsSLO "$tf_base/$tf_zip"
curl -fsSLO "$tf_base/$tf_sums"
curl -fsSLO "$tf_base/$tf_sums.sig"
gpg --batch --status-fd 1 --verify "$tf_sums.sig" "$tf_sums" 2> /dev/null | grep -q "^\[GNUPG:\] VALIDSIG .* $fpr\$"   || die "Terraform $tf_sums signature is not valid for fingerprint $fpr"
grep " $tf_zip\$" "$tf_sums" | sha256sum -c - || die "$tf_zip does not match the signed SHA256SUMS"
unzip -o "$tf_zip" terraform -d /usr/local/bin

# Pinned kubectl, verified against the expected SHA256 before it is installed
curl -fsSLo kubectl "https://dl.k8s.io/release/v${kubectl_version}/bin/linux/amd64/kubectl"
echo "${kubectl_sha256}  kubectl" | sha256sum -c -
install -m 0755 kubectl /usr/local/bin/kubectl

cd /
rm -rf "$workdir"
touch /var/lib/stage2-runner-ready
